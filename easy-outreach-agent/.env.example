# Copia este archivo a .env y llena los valores. Nunca subas .env al repo.

# Seguridad: mientras sea true, nada se envía de verdad (correo ni formularios).
DRY_RUN=true

# Base de datos (SQLite local; luego postgresql+psycopg://...)
DATABASE_URL=sqlite:///data/outreach.db

# Fuentes y auditoría
DENUE_TOKEN=
PAGESPEED_KEY=
# Opcional, apagado por defecto en config/settings.yaml (pide tarjeta en Google Cloud)
GOOGLE_PLACES_KEY=

# Claude (resumen de hallazgos, redacción, clasificación de respuestas)
ANTHROPIC_API_KEY=

# Buzón de envío: norman@hola.easymarketing.mx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Publicación de demos (Cloudflare Pages, demo.easymarketing.mx)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
