---
import { steps } from '../data/site.js';
const BASE = import.meta.env.BASE_URL;
const img = (p) => `${BASE}${p}`.replace(/\/{2,}/g, '/');
---

<section id="experiencia" class="relative bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <header class="mb-12 max-w-2xl reveal">
      <span class="sticker mb-3 inline-block rounded-full bg-sky/40 px-4 py-1.5 font-sub text-sm font-semibold text-ink">
        Cómo funciona
      </span>
      <h2 class="font-display text-[clamp(2.4rem,6vw,4.5rem)] leading-[0.95] text-ink">
        Del <span class="text-sky">mensaje</span> al <span class="text-coral">cielo</span>
      </h2>
      <p class="mt-4 font-body text-lg text-ink/70">
        Cuatro pasos y ya estás flotando sobre Teotihuacán.
      </p>
    </header>

    <!-- línea conectora (desktop) -->
    <div class="relative">
      <div class="pointer-events-none absolute left-0 right-0 top-[92px] hidden h-1 bg-gradient-to-r from-sky via-yellow to-coral lg:block" aria-hidden="true"></div>

      <ol class="no-scrollbar flex snap-x gap-5 overflow-x-auto pb-4 lg:grid lg:grid-cols-4 lg:gap-6 lg:overflow-visible lg:pb-0">
        {steps.map((s) => (
          <li class="reveal w-[78%] shrink-0 snap-start sm:w-[46%] lg:w-auto">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-blob border-2 border-ink bg-cream shadow-card transition-transform hover:-translate-y-1">
              <div class="relative h-40 overflow-hidden">
                <img src={img(s.image)} alt={s.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                <span class="absolute left-3 top-3 grid h-11 w-11 place-items-center rounded-full border-2 border-ink bg-yellow font-display text-2xl text-ink shadow-pop">
                  {s.n}
                </span>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="font-sub text-xl font-semibold text-ink">{s.title}</h3>
                <p class="mt-2 font-body text-[15px] text-ink/70">{s.text}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
