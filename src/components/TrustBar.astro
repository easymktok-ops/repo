---
import { trustItems } from '../data/site.js';

// Iconos lineales (stroke) por clave — sin emojis como iconos.
const icons = {
  calendar: '<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3Z"/><path d="M9 12l2 2 4-4"/>',
  umbrella: '<path d="M12 3v2M3.5 11a8.5 8.5 0 0 1 17 0Z"/><path d="M12 11v7a2.5 2.5 0 0 0 5 0"/>',
  cheers: '<path d="M7 3h10l-1.5 8a3.5 3.5 0 0 1-7 0L7 3Z"/><path d="M12 14v5M8.5 21h7"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/>',
};
---

<section id="confianza" class="bg-ink text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <ul
      class="no-scrollbar flex snap-x gap-3 overflow-x-auto py-5 md:justify-between md:gap-6 md:overflow-visible md:py-6"
    >
      {trustItems.map((item) => (
        <li class="flex shrink-0 snap-start items-center gap-3 rounded-full border border-white/10 bg-white/5 px-5 py-2.5 md:border-0 md:bg-transparent md:px-2 md:py-0">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-yellow text-ink">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
          </span>
          <span class="whitespace-nowrap font-sub text-[15px] font-medium text-white md:text-base">{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
