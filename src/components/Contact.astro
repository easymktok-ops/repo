---
import { contact, waGeneral, packages } from '../data/site.js';
const waLink = waGeneral('Hola 😊 Quiero información y disponibilidad para volar en globo con Happy Puerto.');
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(contact.mapsQuery)}&z=14&output=embed`;
const telHref = `tel:+${contact.whatsappPhone}`;
const BASE = import.meta.env.BASE_URL;
const formAction = `${BASE}enviar-cotizacion.php`.replace(/\/{2,}/g, '/');

const cards = [
  {
    id: 'whatsapp',
    label: 'WhatsApp',
    value: contact.whatsappDisplay,
    href: waLink,
    external: true,
    accent: '#25D366',
    icon: '<path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Z" fill="none"/><path d="M8.5 7.5c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .6.5l.8 2c.1.2 0 .4-.1.5l-.5.6c-.1.1-.2.3-.1.5.5 1 1.6 1.9 2.6 2.3.2.1.4 0 .5-.1l.6-.7c.1-.2.3-.2.5-.1l1.9.9c.2.1.3.3.3.5 0 .6-.2 1.2-.7 1.5-.5.3-1 .4-1.6.3-2.4-.5-5.6-3.3-6.3-6-.1-.6 0-1.2.6-2Z"/>',
  },
  {
    id: 'phone',
    label: 'Teléfono',
    value: contact.whatsappDisplay,
    href: telHref,
    accent: '#7FC7E8',
    icon: '<path d="M5 4h3l1.5 5-2 1.5a11 11 0 0 0 5 5l1.5-2 5 1.5V19a2 2 0 0 1-2 2A16 16 0 0 1 4 6a2 2 0 0 1 1-2Z"/>',
  },
  {
    id: 'email',
    label: 'Email',
    value: contact.email,
    href: `mailto:${contact.email}`,
    accent: '#FF8A5B',
    wide: true,
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/>',
  },
  {
    id: 'address',
    label: 'Dónde estamos',
    value: contact.address,
    accent: '#B98BD6',
    wide: true,
    icon: '<path d="M12 21s-7-6.3-7-11a7 7 0 0 1 14 0c0 4.7-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  },
];
---

<section id="contacto" class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <header class="mb-12 max-w-2xl reveal">
      <span class="sticker mb-3 inline-block rounded-full bg-coral/40 px-4 py-1.5 font-sub text-sm font-semibold text-ink">
        Contacto
      </span>
      <h2 class="font-display text-[clamp(2.4rem,6vw,4.5rem)] leading-[0.95] text-ink">
        ¿Listos para <span class="text-coral">volar</span>?
      </h2>
      <p class="mt-4 font-body text-lg text-ink/70">
        Déjanos tus datos y te enviamos tu cotización, o escríbenos directo por WhatsApp.
      </p>
    </header>

    <div class="grid items-start gap-8 lg:grid-cols-2">
      <!-- Formulario de cotización -->
      <div class="reveal rounded-blob border-2 border-ink bg-cream p-6 shadow-pop sm:p-8">
        <h3 class="font-display text-2xl text-ink">Solicita tu cotización</h3>
        <p class="mt-1 font-sub text-sm text-ink/60">Te contactamos por WhatsApp o teléfono. Sin pagos en línea.</p>

        <!-- Aviso de error (si el envío falla, el servidor regresa aquí con ?error) -->
        <p id="form-error" hidden class="mt-4 rounded-xl border-2 border-coral bg-coral/10 px-4 py-3 font-sub text-sm font-semibold text-ink">
          Ups, no pudimos enviar tu solicitud. Revisa los campos obligatorios o escríbenos por WhatsApp.
        </p>

        <form action={formAction} method="POST" class="mt-6 grid gap-4" novalidate>
          <!-- Honeypot anti-spam (oculto) -->
          <div class="hidden" aria-hidden="true">
            <label>No llenar<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1 block font-sub text-sm font-semibold text-ink/80">Nombre <span class="text-coral">*</span></span>
              <input type="text" name="nombre" required autocomplete="name" placeholder="Tu nombre"
                class="block w-full min-w-0 rounded-xl border-2 border-ink bg-white px-4 py-3 font-body text-base text-ink placeholder:text-ink/40 focus:border-yellow-dk focus:outline-none" />
            </label>
            <label class="block">
              <span class="mb-1 block font-sub text-sm font-semibold text-ink/80">WhatsApp / Teléfono <span class="text-coral">*</span></span>
              <input type="tel" name="telefono" required inputmode="tel" autocomplete="tel" placeholder="55 1234 5678"
                class="block w-full min-w-0 rounded-xl border-2 border-ink bg-white px-4 py-3 font-body text-base text-ink placeholder:text-ink/40 focus:border-yellow-dk focus:outline-none" />
            </label>
          </div>

          <label class="block">
            <span class="mb-1 block font-sub text-sm font-semibold text-ink/80">Correo (opcional)</span>
            <input type="email" name="email" autocomplete="email" placeholder="tucorreo@ejemplo.com"
              class="block w-full min-w-0 rounded-xl border-2 border-ink bg-white px-4 py-3 font-body text-base text-ink placeholder:text-ink/40 focus:border-yellow-dk focus:outline-none" />
          </label>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1 block font-sub text-sm font-semibold text-ink/80">Personas</span>
              <input type="number" name="personas" min="1" max="20" value="2"
                class="block w-full min-w-0 rounded-xl border-2 border-ink bg-white px-4 py-3 font-body text-base text-ink focus:border-yellow-dk focus:outline-none" />
            </label>
            <label class="block">
              <span class="mb-1 block font-sub text-sm font-semibold text-ink/80">Fecha tentativa</span>
              <input type="date" name="fecha" id="fecha-vuelo"
                class="block w-full min-w-0 max-w-full appearance-none rounded-xl border-2 border-ink bg-white px-4 py-3 font-body text-base text-ink focus:border-yellow-dk focus:outline-none" />
            </label>
          </div>

          <label class="block">
            <span class="mb-1 block font-sub text-sm font-semibold text-ink/80">Paquete de interés</span>
            <select name="paquete"
              class="block w-full min-w-0 rounded-xl border-2 border-ink bg-white px-4 py-3 font-body text-base text-ink focus:border-yellow-dk focus:outline-none">
              <option value="">Selecciona un paquete…</option>
              {packages.map((p) => (
                <option value={`${p.name} ($${p.price.toLocaleString('es-MX')} MXN)`}>{p.name} — ${p.price.toLocaleString('es-MX')} MXN</option>
              ))}
              <option value="Aún no lo sé / Ayúdenme a elegir">Aún no lo sé, ayúdenme a elegir</option>
            </select>
          </label>

          <label class="block">
            <span class="mb-1 block font-sub text-sm font-semibold text-ink/80">Mensaje (opcional)</span>
            <textarea name="mensaje" rows="3" placeholder="¿Alguna ocasión especial? Cuéntanos."
              class="block w-full min-w-0 rounded-xl border-2 border-ink bg-white px-4 py-3 font-body text-base text-ink placeholder:text-ink/40 focus:border-yellow-dk focus:outline-none"></textarea>
          </label>

          <label class="flex items-start gap-2.5">
            <input type="checkbox" name="consent" value="si" required
              class="mt-1 h-5 w-5 shrink-0 rounded border-2 border-ink text-yellow-dk focus:ring-yellow-dk" />
            <span class="font-sub text-sm text-ink/70">Acepto que Happy Puerto me contacte para dar seguimiento a mi solicitud. <span class="text-coral">*</span></span>
          </label>

          <button type="submit"
            class="mt-1 inline-flex w-full items-center justify-center gap-2 rounded-full border-2 border-ink bg-yellow px-6 py-3.5 font-sub text-base font-semibold text-ink shadow-pop transition-transform hover:-translate-y-0.5 active:translate-y-0">
            Enviar solicitud
          </button>
          <p class="text-center font-sub text-xs text-ink/50">Campos con <span class="text-coral">*</span> son obligatorios.</p>
        </form>
      </div>

      <!-- WhatsApp + datos -->
      <div class="reveal grid gap-4 sm:grid-cols-2">
        <a href={waLink} target="_blank" rel="noopener"
          class="group flex items-center gap-4 rounded-blob border-2 border-ink bg-wa/10 p-5 shadow-pop transition-transform hover:-translate-y-1 sm:col-span-2">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full border-2 border-ink bg-wa text-white">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.6 14.2c-.2.6-1.2 1.2-1.7 1.2-.4 0-1 .1-3.2-.8-2.7-1.1-4.4-3.9-4.6-4.1-.1-.2-1-1.4-1-2.6 0-1.2.6-1.8.9-2 .2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.1.1.3 0 .5l-.5.6c-.1.2-.3.3-.1.6.5 1 1.6 1.9 2.6 2.3.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.2.1.6-.1 1.1Z"/></svg>
          </span>
          <span class="min-w-0">
            <span class="block font-sub text-sm font-semibold text-ink/60">¿Prefieres WhatsApp?</span>
            <span class="block font-sub text-lg font-semibold text-ink">Escríbenos ahora mismo →</span>
          </span>
        </a>

        {cards.map((c) => {
          const Tag = c.href ? 'a' : 'div';
          return (
            <Tag
              href={c.href}
              {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
              class:list={["group flex items-start gap-4 rounded-blob border-2 border-ink bg-cream p-5 shadow-pop transition-transform hover:-translate-y-1", c.wide && 'sm:col-span-2']}
            >
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full border-2 border-ink text-ink" style={`background:${c.accent}`}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
              </span>
              <span class="min-w-0">
                <span class="block font-sub text-sm font-semibold text-ink/60">{c.label}</span>
                <span class={`block font-sub font-semibold text-ink break-words ${c.id === 'email' ? 'text-[clamp(0.72rem,3.4vw,1.05rem)]' : 'text-lg'}`}>{c.value}</span>
              </span>
            </Tag>
          );
        })}

        <!-- Mapa -->
        <div class="overflow-hidden rounded-blob border-2 border-ink shadow-card sm:col-span-2">
          <iframe
            title="Ubicación de Happy Puerto en San Martín de las Pirámides"
            src={mapEmbed}
            width="100%"
            height="100%"
            style="min-height:300px;border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    // Fecha mínima = hoy; y muestra aviso si el servidor regresó con ?error
    (function () {
      var d = document.getElementById('fecha-vuelo');
      if (d) { try { d.min = new Date().toISOString().split('T')[0]; } catch (e) {} }
      if (/[?&]error/.test(location.search)) {
        var box = document.getElementById('form-error');
        if (box) { box.hidden = false; box.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
      }
    })();
  </script>
</section>
