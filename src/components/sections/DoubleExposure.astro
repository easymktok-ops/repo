---
import { Image } from "astro:assets";
import Button from "@components/ui/Button.astro";
import { whatsappUrl, type Locale } from "@config/site";
import { img } from "@lib/media";

/**
 * "Lo que se ve alla arriba": una toma aerea majestuosa del globo de marca sobre
 * el mar de nubes, mostrada COMPLETA (sin recortes ni mascaras). Reveal
 * cinematografico al entrar: la imagen se abre en letterbox + asienta la escala,
 * con un bloom fucsia detras. Todo con CSS scroll-driven (cero JS): degrada a
 * imagen visible donde no hay soporte y respeta prefers-reduced-motion.
 *
 * (Reemplaza la version de silueta/fondo-fijo, que en iOS se veia borrosa.)
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const t = {
  es: {
    heading: "Lo que se ve allá arriba",
    sub: "no cabe en una sola foto. Por eso te llevamos a verlo en persona.",
    cta: "Reservar vuelo",
    alt: "Globo de Aerodiverti sobre el mar de nubes al amanecer, vista aérea",
  },
  en: {
    heading: "What you see up there",
    sub: "does not fit in a single photo. So we take you to see it in person.",
    cta: "Book a flight",
    alt: "Aerodiverti balloon above a sea of clouds at sunrise, aerial view",
  },
}[locale];

const aerial = img("galeria-04.jpg");
const bookHref = whatsappUrl(
  locale === "es"
    ? "Hola, quiero reservar un vuelo en globo en Teotihuacán. ¿Me ayudan?"
    : "Hi, I'd like to book a balloon flight in Teotihuacán. Can you help?",
);
---

<section class="de">
  <div class="de-inner container">
    <div class="de-copy">
      <h2 class="de-h">{t.heading}</h2>
      <p class="de-sub measure">{t.sub}</p>
      <Button href={bookHref} size="lg" icon="arrow-up-right" target="_blank" rel="noopener">
        {t.cta}
      </Button>
    </div>

    <div class="de-stage">
      <span class="de-glow" aria-hidden="true"></span>
      <figure class="de-frame">
        <Image
          class="de-img"
          src={aerial}
          alt={t.alt}
          widths={[560, 900, 1280]}
          sizes="(min-width: 900px) 46vw, 92vw"
          format="avif"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .de {
    position: relative;
    overflow: hidden;
    background: var(--bg-deep);
    padding-block: var(--space-3xl);
    border-block: 1px solid var(--line-faint);
  }
  .de-inner {
    position: relative;
    z-index: var(--z-raised);
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  @media (min-width: 900px) {
    .de-inner {
      grid-template-columns: 1fr 1.05fr;
    }
  }

  .de-h {
    font-size: var(--step-4);
    line-height: 1.02;
  }
  .de-sub {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  /* --- Escenario de la imagen --- */
  .de-stage {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 640px;
  }
  /* Bloom fucsia detras del marco (marca + profundidad). */
  .de-glow {
    position: absolute;
    inset: 6% 4%;
    z-index: 0;
    border-radius: 40%;
    background: radial-gradient(60% 60% at 50% 45%, oklch(0.74 0.145 344 / 0.45), transparent 70%);
    filter: blur(48px);
    opacity: 0;
  }
  .de-frame {
    position: relative;
    z-index: 1;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 16 / 10;
    background: var(--surface-sunken);
  }
  .de-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform-origin: center;
  }
  /* Scrim inferior sutil para dar cuerpo cinematografico. */
  .de-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, oklch(0.12 0.02 260 / 0.45), transparent 46%);
    pointer-events: none;
  }

  /* --- Reveal cinematografico (scroll-driven, cero JS) ---
     Estado base = imagen completamente visible (fallback seguro). El reveal solo
     se activa con soporte de animation-timeline y con movimiento permitido. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .de-img {
        animation: deOpen linear both;
        animation-timeline: view();
        animation-range: entry 6% cover 44%;
      }
      .de-glow {
        animation: deBloom linear both;
        animation-timeline: view();
        animation-range: entry 4% cover 40%;
      }
    }
  }
  @keyframes deOpen {
    from {
      clip-path: inset(46% 0 46% 0);
      transform: scale(1.14);
    }
    to {
      clip-path: inset(0 0 0 0);
      transform: scale(1);
    }
  }
  @keyframes deBloom {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
