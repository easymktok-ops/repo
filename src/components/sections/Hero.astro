---
import { Image } from "astro:assets";
import Button from "@components/ui/Button.astro";
import { localizedPath, type Locale } from "@config/site";
import { img } from "@lib/media";

/**
 * Hero (patron 5.1): video a sangre completa con poster precargado como LCP.
 * - Poster = <Image> optimizado (AVIF/WebP), eager + fetchpriority=high. Es el
 *   LCP y nunca lo bloquea el video.
 * - Video diferido: no autoplay; un script lo arranca despues de window.load y
 *   solo si prefers-reduced-motion: no-preference. Aparece con fade sobre el
 *   poster. Bajo reduced-motion se queda el poster fijo.
 * - Scrim direccional para contraste del texto (>=4.5:1) sin apagar la imagen.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = {
  es: {
    title: "Un amanecer que solo se vive volando",
    subtitle:
      "Vuelos en globo sobre el valle de Teotihuacán. Pilotos certificados AFAC y reprogramación sin costo.",
    primary: "Reservar vuelo",
    secondary: "Ver vuelos",
  },
  en: {
    title: "A sunrise you only live by flying",
    subtitle:
      "Hot-air balloon flights over the Teotihuacán valley. AFAC-certified pilots and free rescheduling.",
    primary: "Book a flight",
    secondary: "See flights",
  },
}[locale];

const bookHref = localizedPath("/reservar", locale);
const flightsHref = localizedPath("/vuelos", locale);
const poster = img("galeria-03.jpg");
const posterAlt =
  locale === "es"
    ? "Globo de Aerodiverti sobre las pirámides de Teotihuacán al amanecer"
    : "Aerodiverti balloon over the Teotihuacán pyramids at sunrise";
---

<section class="hero">
  <div class="hero-media" aria-hidden={false}>
    <Image
      class="hero-poster"
      src={poster}
      alt={posterAlt}
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      format="avif"
    />
    <video class="hero-video" muted loop playsinline preload="none">
      <source src="/videos/hero-loop.mp4" type="video/mp4" />
    </video>
    <div class="hero-scrim"></div>
  </div>

  <div class="hero-content container">
    <h1 class="hero-title">{copy.title}</h1>
    <p class="hero-sub">{copy.subtitle}</p>
    <div class="hero-cta">
      <Button href={bookHref} size="lg" icon="arrow-up-right">{copy.primary}</Button>
      <Button href={flightsHref} size="lg" variant="ghost">{copy.secondary}</Button>
    </div>
  </div>
</section>

<script>
  // Video diferido: arranca tras la carga y solo si el usuario acepta movimiento.
  const v = document.querySelector<HTMLVideoElement>(".hero-video");
  if (v && window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const start = () => {
      v.play()
        .then(() => v.classList.add("is-playing"))
        .catch(() => {});
    };
    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - var(--topbar-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--bg-deep);
  }
  @media (min-width: 1024px) {
    .hero {
      min-height: 100dvh;
      align-items: center;
    }
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-video {
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }
  .hero-video.is-playing {
    opacity: 1;
  }

  /* Scrim direccional: mas denso abajo y a la izquierda, donde vive el texto. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        var(--scrim-from) 0%,
        var(--scrim-from) 20%,
        var(--scrim-mid) 52%,
        var(--scrim-to) 84%
      ),
      linear-gradient(to top, var(--scrim-from) 2%, transparent 46%);
  }

  .hero-content {
    position: relative;
    z-index: var(--z-raised);
    padding-block: var(--space-2xl);
    width: 100%;
  }
  .hero-title {
    font-size: clamp(2.5rem, 1.5rem + 3.4vw, 4.5rem);
    font-weight: 700;
    max-width: 16ch;
    color: var(--ink);
    animation: rise var(--dur-hero) var(--ease-out) both;
  }
  .hero-sub {
    margin-top: var(--space-md);
    max-width: 42ch;
    font-size: var(--step-1);
    color: var(--ink-soft);
    animation: rise var(--dur-hero) var(--ease-out) 0.08s both;
  }
  .hero-cta {
    margin-top: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    animation: rise var(--dur-hero) var(--ease-out) 0.16s both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-sub,
    .hero-cta {
      animation: none;
    }
    .hero-video {
      transition: none;
    }
  }
</style>
