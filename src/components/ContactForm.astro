---
import { services } from '../i18n/services';
import { site } from '../i18n/site';
import { wb } from '../lib/paths';
import { useTranslations, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const thankyou = wb(`/${lang}/gracias/`);
---
<form class="cform" action={site.formEndpoint} method="POST" novalidate>
  <!-- Web3Forms -->
  <input type="hidden" name="access_key" value={site.web3formsKey} />
  <input type="hidden" name="subject" value={lang === 'es' ? 'Nueva solicitud — The Spa Mita' : 'New request — The Spa Mita'} />
  <input type="hidden" name="from_name" value="The Spa Mita — Web" />
  <!-- Redirección a la thank-you page tras envío exitoso -->
  <input type="hidden" name="redirect" value={new URL(thankyou, Astro.site).href} />
  <input type="hidden" name="idioma_seleccionado" value={lang === 'es' ? 'Español' : 'English'} />
  <input type="hidden" name="pagina_origen" value="" data-origin />
  <!-- Honeypot anti-spam (Web3Forms) -->
  <input type="checkbox" name="botcheck" class="cform__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="cform__field">
    <label for="nombre">{t('form.nombre')} *</label>
    <input id="nombre" name="nombre" type="text" required autocomplete="name" />
    <span class="cform__err" data-err>{t('form.req')}</span>
  </div>

  <div class="cform__field">
    <label for="telefono">{t('form.telefono')} *</label>
    <input id="telefono" name="telefono" type="tel" required autocomplete="tel" />
    <span class="cform__err" data-err>{t('form.req')}</span>
  </div>

  <div class="cform__field">
    <label for="servicio">{t('form.servicio')} *</label>
    <select id="servicio" name="servicio" required>
      <option value="" selected disabled>{t('form.servicio.placeholder')}</option>
      {services.map((c) => <option value={c.name.es}>{c.name[lang]}</option>)}
      <option value="Otro">{t('form.servicio.otro')}</option>
    </select>
    <span class="cform__err" data-err>{t('form.req')}</span>
  </div>

  <div class="cform__field">
    <label for="fecha">{t('form.fecha')}</label>
    <input id="fecha" name="fecha_preferida" type="datetime-local" />
  </div>

  <div class="cform__field">
    <label for="mensaje">{t('form.mensaje')}</label>
    <textarea id="mensaje" name="mensaje" rows="4"></textarea>
  </div>

  <label class="cform__check">
    <input type="checkbox" name="primera_vez" value="Sí" />
    <span>{t('form.primera')}</span>
  </label>

  <div class="cform__actions">
    <button type="submit" class="btn btn--solid">{t('form.enviar')}</button>
    <span class="cform__or">{t('form.or')}</span>
    <button type="button" class="btn btn--ghost cform__wa" data-wa data-phone={site.whatsappPhone} data-lang={lang}>
      <svg viewBox="0 0 32 32" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M16 3C9 3 3.3 8.7 3.3 15.7c0 2.5.7 4.8 1.9 6.8L3 29l6.7-2.1c2 1.1 4.2 1.7 6.4 1.7 7 0 12.7-5.7 12.7-12.7S23 3 16 3zm0 23c-2 0-3.9-.6-5.6-1.6l-.4-.2-4 1.2 1.2-3.9-.3-.4A10.4 10.4 0 0 1 5.6 15.7C5.6 10 10.3 5.3 16 5.3S26.4 10 26.4 15.7 21.7 26 16 26zm5.9-7.8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.6 8.6 0 0 1-2.5-1.6 9.5 9.5 0 0 1-1.8-2.2c-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6s.1-.4 0-.6-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4a3.5 3.5 0 0 0-1.1 2.6c0 1.5 1.1 3 1.3 3.2s2.2 3.4 5.3 4.7c2 .8 2.7.9 3.7.8.6-.1 1.9-.8 2.1-1.5.3-.8.3-1.4.2-1.5s-.3-.2-.6-.4z"/></svg>
      {t('form.wa')}
    </button>
  </div>
</form>

<script>
  const form = document.querySelector('.cform');
  if (form) {
    const origin = form.querySelector('[data-origin]');
    if (origin) origin.value = location.href;

    // Preselección de servicio desde la URL (?servicio=...)
    try {
      const pre = new URLSearchParams(location.search).get('servicio');
      if (pre) {
        const sel = form.querySelector('#servicio');
        const match = Array.from(sel.options).find((o) => o.value === pre);
        if (match) { sel.value = pre; sel.classList.add('is-prefilled'); }
      }
    } catch (e) {}

    // Enviar por WhatsApp: arma un mensaje con los datos del formulario
    const waBtn = form.querySelector('[data-wa]');
    if (waBtn) {
      waBtn.addEventListener('click', () => {
        let ok = true;
        form.querySelectorAll('[required]').forEach((el) => {
          const f = el.closest('.cform__field');
          const bad = !el.value || !String(el.value).trim();
          f?.classList.toggle('is-invalid', bad);
          if (bad) ok = false;
        });
        if (!ok) { form.querySelector('.is-invalid input, .is-invalid select')?.focus(); return; }
        const lng = waBtn.getAttribute('data-lang') || 'es';
        const phone = waBtn.getAttribute('data-phone');
        const g = (n) => (form.querySelector('[name="' + n + '"]')?.value || '').trim();
        const L = lng === 'en'
          ? { intro: 'Hi, I would like to book at The Spa Mita.', nombre: 'Name', telefono: 'Phone', servicio: 'Service', fecha: 'Preferred date', mensaje: 'Message', primera: 'First time', yes: 'Yes' }
          : { intro: 'Hola, quiero reservar en The Spa Mita.', nombre: 'Nombre', telefono: 'Teléfono', servicio: 'Servicio', fecha: 'Fecha tentativa', mensaje: 'Mensaje', primera: 'Primera vez', yes: 'Sí' };
        const lines = [L.intro, ''];
        lines.push(L.nombre + ': ' + g('nombre'));
        lines.push(L.telefono + ': ' + g('telefono'));
        lines.push(L.servicio + ': ' + g('servicio'));
        if (g('fecha_preferida')) lines.push(L.fecha + ': ' + g('fecha_preferida'));
        if (g('mensaje')) lines.push(L.mensaje + ': ' + g('mensaje'));
        if (form.querySelector('[name="primera_vez"]')?.checked) lines.push(L.primera + ': ' + L.yes);
        const text = encodeURIComponent(lines.join('\n'));
        window.open('https://api.whatsapp.com/send?phone=' + phone + '&text=' + text, '_blank', 'noopener');
      });
    }

    form.addEventListener('submit', (e) => {
      let ok = true;
      form.querySelectorAll('[required]').forEach((el) => {
        const field = el.closest('.cform__field');
        const invalid = !el.value || (el.type !== 'checkbox' && !String(el.value).trim());
        field?.classList.toggle('is-invalid', invalid);
        if (invalid) ok = false;
      });
      if (!ok) { e.preventDefault(); form.querySelector('.is-invalid input, .is-invalid select')?.focus(); }
    });
  }
</script>

<style>
  .cform { max-width: 560px; display: flex; flex-direction: column; gap: 1.5rem; }
  .cform__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cform__field { display: flex; flex-direction: column; gap: 0.4rem; }
  .cform label { font-size: var(--fs-sm); letter-spacing: 0.04em; color: var(--color-text); }

  /* Campos tipo "underline", sin cajas con border-radius */
  .cform input, .cform select, .cform textarea {
    font-family: var(--font-sans); font-weight: var(--fw-light); font-size: var(--fs-base);
    color: var(--color-text); background: transparent;
    border: 0; border-bottom: 1px solid var(--color-line);
    border-radius: 0; padding: 0.5rem 0; width: 100%;
    transition: border-color 0.3s var(--ease-soft);
  }
  .cform input:focus, .cform select:focus, .cform textarea:focus {
    outline: none; border-bottom-color: var(--clay-700);
  }
  .cform textarea { resize: vertical; }

  .cform select.is-prefilled { border-bottom-color: var(--clay-700); color: var(--clay-900); }
  .cform__err { display: none; font-size: var(--fs-xs); color: #b23b3b; }
  .cform__field.is-invalid .cform__err { display: block; }
  .cform__field.is-invalid input, .cform__field.is-invalid select { border-bottom-color: #b23b3b; }

  .cform__check { flex-direction: row; align-items: center; gap: 0.6rem; cursor: pointer; }
  .cform__check input { width: auto; }
  .cform__actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .cform__or { color: var(--color-text-muted); font-size: var(--fs-sm); }
  .cform__wa { display: inline-flex; align-items: center; gap: 0.5rem; }
</style>
