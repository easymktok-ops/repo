---
import { reviews, viatorUrl } from '../data/site.js';

// ⚠️ FASE 1: reseñas de ejemplo (placeholder). En Fase 2 se reemplazan por
// reseñas reales (Google / Viator) y se conecta el link real de Viator.
const accents = ['#7FC7E8', '#FF8A5B', '#6FD8A4'];
---

<section id="resenas" class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <header class="mx-auto mb-12 max-w-2xl text-center reveal">
      <span class="sticker mb-3 inline-block rounded-full bg-mint/40 px-4 py-1.5 font-sub text-sm font-semibold text-ink">
        Reseñas
      </span>
      <h2 class="font-display text-[clamp(2.4rem,6vw,4.5rem)] leading-[0.95] text-ink">
        Nos llenan de <span class="text-yellow-dk">estrellas</span>
      </h2>
      <p class="mt-4 font-body text-lg text-ink/70">
        Esto dicen quienes ya volaron con nosotros.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-3">
      {reviews.map((r, i) => (
        <figure class="reveal flex h-full flex-col rounded-blob border-2 border-ink bg-cream p-6 shadow-card" style={`transition-delay:${i * 80}ms`}>
          <div class="mb-3 flex items-center gap-1" aria-label={`${r.stars} de 5 estrellas`}>
            {Array.from({ length: 5 }).map((_, s) => (
              <svg width="20" height="20" viewBox="0 0 24 24" fill={s < r.stars ? '#F4B400' : '#E5E0CF'} aria-hidden="true">
                <path d="M12 2l2.9 6 6.6.6-5 4.3 1.5 6.5L12 16.9 5.9 19.4 7.4 12.9 2.4 8.6 9 8z" />
              </svg>
            ))}
          </div>
          <blockquote class="flex-1 font-body text-ink/85">"{r.text}"</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-full border-2 border-ink font-display text-xl text-ink" style={`background:${accents[i % accents.length]}`}>
              {r.initial}
            </span>
            <span class="font-sub font-semibold text-ink">{r.name}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-10 text-center reveal">
      {/* TODO Fase 2: usar la URL real de Viator cuando el cliente la entregue. */}
      <a
        href={viatorUrl || '#resenas'}
        {...(viatorUrl ? { target: '_blank', rel: 'noopener' } : { 'aria-disabled': 'true' })}
        class:list={[
          'inline-flex items-center gap-2 rounded-full border-2 border-ink px-6 py-3 font-sub font-semibold text-ink transition-transform hover:-translate-y-0.5',
          viatorUrl ? 'bg-yellow shadow-pop' : 'cursor-not-allowed bg-white opacity-60',
        ]}
      >
        Ver todas las reseñas en Viator
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
      </a>
      {!viatorUrl && (
        <p class="mt-3 font-body text-sm text-ink/50">Próximamente — enlace disponible en la Fase 2.</p>
      )}
    </div>
  </div>
</section>
