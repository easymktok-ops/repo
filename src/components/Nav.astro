---
import { siteMeta } from '../data/site.js';
const logo = `${import.meta.env.BASE_URL}assets/logo-happy-puerto.svg`.replace(/\/{2,}/g, '/');

const links = [
  { href: '#paquetes', label: 'Paquetes' },
  { href: '#experiencia', label: 'Experiencia' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
  >
    <!-- Logo -->
    <a href="#top" class="flex items-center gap-2.5 shrink-0" aria-label={`${siteMeta.name} — inicio`}>
      <img src={logo} alt={siteMeta.name} width="48" height="48" class="h-11 w-11 sm:h-12 sm:w-12 animate-bob" />
      <span class="font-display text-xl sm:text-2xl leading-none text-ink hidden sm:block">Happy Puerto</span>
    </a>

    <!-- Links desktop -->
    <ul class="hidden md:flex items-center gap-7 font-sub font-medium text-ink">
      {links.map((l) => (
        <li>
          <a href={l.href} class="relative py-1 transition-colors hover:text-yellow-dk after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-yellow after:transition-transform hover:after:scale-x-100">
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA desktop -->
    <a
      href="#paquetes"
      class="hidden md:inline-flex items-center gap-1.5 rounded-full bg-ink px-5 py-2.5 font-sub font-semibold text-white shadow-pop transition-transform hover:-translate-y-0.5 active:translate-y-0"
    >
      ¡Reserva ahora! <span aria-hidden="true">🎈</span>
    </a>

    <!-- Hamburger -->
    <button
      id="nav-toggle"
      class="md:hidden inline-flex h-11 w-11 items-center justify-center rounded-full bg-ink text-white"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="nav-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="nav-icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </nav>

  <!-- Menú móvil -->
  <div
    id="mobile-menu"
    class="md:hidden hidden origin-top border-t border-ink/10 bg-cream/95 backdrop-blur-md"
  >
    <ul class="flex flex-col gap-1 px-5 py-4 font-sub text-lg font-medium">
      {links.map((l) => (
        <li>
          <a href={l.href} class="mobile-link block rounded-xl px-3 py-3 transition-colors hover:bg-yellow-lt">{l.label}</a>
        </li>
      ))}
      <li class="pt-2">
        <a href="#paquetes" class="mobile-link block rounded-full bg-ink px-5 py-3 text-center font-semibold text-white">
          ¡Reserva ahora! 🎈
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  // Sticky blur al hacer scroll
  const onScroll = () => {
    if (window.scrollY > 24) {
      nav.classList.add('bg-cream/80', 'backdrop-blur-md', 'shadow-[0_4px_20px_-8px_rgba(0,0,0,0.2)]');
    } else {
      nav.classList.remove('bg-cream/80', 'backdrop-blur-md', 'shadow-[0_4px_20px_-8px_rgba(0,0,0,0.2)]');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menú móvil
  let open = false;
  const setMenu = (v) => {
    open = v;
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };
  toggle.addEventListener('click', () => setMenu(!open));
  document.querySelectorAll('.mobile-link').forEach((a) =>
    a.addEventListener('click', () => setMenu(false))
  );
</script>
