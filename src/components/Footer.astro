---
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../i18n/site';
import { wb } from '../lib/paths';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__grid">
    <!-- Marca + dirección -->
    <div class="footer__col">
      <img class="footer__logo" src={wb('/img/optimized/full/THe-Spa-logo.webp')} alt="The Spa Mita" width="180" height="48" loading="lazy" />
      <p class="footer__addr">
        {site.address.street}<br />
        {site.address.postalCode} {site.address.locality}, {site.address.region}, México
      </p>
      <p class="footer__meta"><span>{t('footer.hours')}</span> {t('side.horario.valor')}</p>
      <p class="footer__meta">
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={site.whatsapp} target="_blank" rel="noopener noreferrer">{site.phoneDisplay}</a>
      </p>
    </div>

    <!-- Reseñas + redes -->
    <div class="footer__col">
      <p class="footer__h">{t('footer.reviews')}</p>
      <a class="footer__ta" href={site.tripadvisor} target="_blank" rel="noopener noreferrer">
        <img src={wb('/img/optimized/full/49318-008d3131.webp')} alt="TripAdvisor" width="28" height="28" loading="lazy" />
        <span>TripAdvisor</span>
      </a>
      <p class="footer__h footer__h--mt">{t('footer.follow')}</p>
      <div class="footer__social">
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2m0 1.9c-3.1 0-3.5 0-4.7.1-.9 0-1.4.2-1.7.3-.4.2-.7.4-1 .7-.3.3-.5.6-.7 1-.1.3-.3.8-.3 1.7-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c0 .9.2 1.4.3 1.7.2.4.4.7.7 1 .3.3.6.5 1 .7.3.1.8.3 1.7.3 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c.9 0 1.4-.2 1.7-.3.4-.2.7-.4 1-.7.3-.3.5-.6.7-1 .1-.3.3-.8.3-1.7.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c0-.9-.2-1.4-.3-1.7-.2-.4-.4-.7-.7-1-.3-.3-.6-.5-1-.7-.3-.1-.8-.3-1.7-.3-1.2-.1-1.6-.1-4.7-.1m0 3.2a4.7 4.7 0 1 1 0 9.4 4.7 4.7 0 0 1 0-9.4m0 7.7a3 3 0 1 0 0-6 3 3 0 0 0 0 6m6-8a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0"/></svg>
        </a>
        <a href={site.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12"/></svg>
        </a>
      </div>
    </div>

    <!-- Mapa -->
    <div class="footer__col footer__col--map">
      <p class="footer__h">{t('footer.find')}</p>
      <div class="footer__map">
        <iframe
          src={site.mapEmbed}
          title="Google Maps — The Spa Mita"
          loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          width="100%" height="100%" style="border:0;"></iframe>
      </div>
      <a class="footer__maplink" href={site.mapLink} target="_blank" rel="noopener noreferrer">{t('footer.map')} →</a>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {year} The Spa Mita. {t('footer.rights')}</span>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--color-line); background: var(--clay-050); padding-block: clamp(2.5rem, 5vw, 4rem) 0; }
  .footer__grid { display: grid; grid-template-columns: 1.1fr 1fr 1.3fr; gap: clamp(2rem, 5vw, 4rem); }
  .footer__logo { height: 42px; width: auto; margin-bottom: 1rem; }
  .footer__addr { color: var(--color-text); margin: 0 0 1rem; }
  .footer__meta { font-size: var(--fs-sm); color: var(--color-text-muted); margin: 0 0 0.7rem; line-height: 1.7; }
  .footer__meta span { display: block; font-size: var(--fs-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--clay-700); }
  .footer__meta a:hover { color: var(--clay-700); }

  .footer__h { font-size: var(--fs-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--clay-700); margin: 0 0 0.8rem; }
  .footer__h--mt { margin-top: 1.6rem; }
  .footer__ta { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--color-text); }
  .footer__ta img { width: 26px; height: 26px; }
  .footer__ta:hover { color: var(--clay-700); }
  .footer__social { display: flex; gap: 0.9rem; }
  .footer__social a { color: var(--clay-900); transition: color 0.3s var(--ease-soft); }
  .footer__social a:hover { color: var(--clay-700); }

  .footer__map { aspect-ratio: 16 / 10; border: 1px solid var(--color-line); overflow: hidden; background: #fff; }
  .footer__map iframe { display: block; width: 100%; height: 100%; }
  .footer__maplink { display: inline-block; margin-top: 0.7rem; font-size: var(--fs-sm); color: var(--clay-700); border-bottom: 1px solid var(--clay-500); }

  .footer__bottom { margin-top: clamp(2rem, 4vw, 3rem); padding-block: 1.4rem; border-top: 1px solid var(--color-line); font-size: var(--fs-xs); color: var(--color-text-muted); }

  @media (max-width: 860px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__col--map { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>
