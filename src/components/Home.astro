---
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../i18n/site';
import { wb } from '../lib/paths';
import { services } from '../i18n/services';
import Brands from './Brands.astro';
import Faq from './Faq.astro';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const base = wb(`/${lang}`);
const bookHref = (servicio: string) => wb(`/${lang}/contacto/`) + `?servicio=${encodeURIComponent(servicio)}`;
---
<!-- HERO -->
<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <img
      src={wb('/img/optimized/full/hero-punta-mita.webp')}
      alt=""
      fetchpriority="high"
      width="1600" height="2401"
      data-parallax
    />
    <div class="hero__scrim"></div>
  </div>
  <div class="hero__content container">
    <p class="eyebrow">{t('hero.eyebrow')}</p>
    <h1 class="hero__title">{t('hero.title')}</h1>
    <p class="hero__subtitle">{t('hero.subtitle')}</p>
    <div class="hero__actions">
      <a href={`${base}/contacto/`} class="btn btn--solid">{t('hero.cta')}</a>
      <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">{t('hero.cta2')}</a>
    </div>
  </div>
</section>

<!-- INTRO / COPY DE MARCA -->
<section class="section container intro">
  <div class="intro__lead reveal">
    <p class="eyebrow">{t('intro.eyebrow')}</p>
    <p class="intro__first display">{t('intro.p1')}</p>
  </div>
  <div class="intro__body reveal">
    <p>{t('intro.p2')}</p>
    <p>{t('intro.p3')}</p>
    <p>{t('intro.p4')}</p>
  </div>
</section>

<!-- SERVICIOS -->
<section class="section serv" id="servicios">
  <div class="container">
    <div class="serv__head reveal">
      <p class="eyebrow">{t('serv.eyebrow')}</p>
      <h2>{t('serv.title')}</h2>
    </div>
    <div class="serv__grid reveal">
      {services.map((c, i) => (
        <a class="serv__item" href={bookHref(c.name.es)}>
          <span class="serv__n">{String(i + 1).padStart(2, '0')}</span>
          <span class="serv__name">{c.name[lang]}</span>
          <span class="serv__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    <a href={`${base}/servicios/`} class="btn btn--ghost serv__more">{t('nav.servicios')}</a>
  </div>
</section>

<!-- MARCAS -->
<Brands lang={lang} />

<!-- FAQ -->
<Faq lang={lang} />

<!-- CTA CONTACTO -->
<section class="section cta">
  <div class="container cta__inner reveal">
    <h2 class="cta__title">{t('form.title')}</h2>
    <div class="cta__actions">
      <a href={`${base}/contacto/`} class="btn btn--solid">{t('nav.reservar')}</a>
      <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">{t('hero.cta2')}</a>
    </div>
  </div>
</section>

<style>
  /* HERO */
  .hero { position: relative; min-height: 84vh; display: flex; align-items: flex-end; overflow: hidden; }
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .hero__media img {
    position: absolute; left: 0; top: -8%;
    width: 100%; height: 116%; object-fit: cover; object-position: center 62%;
    transform: translate3d(0,0,0) scale(1.02); will-change: transform;
  }
  @media (max-width: 760px) {
    /* En mobile la imagen es vertical y se aprecia completa */
    .hero__media img { object-position: center 40%; }
  }
  /* Doble scrim: horizontal para desktop + vertical para mobile, garantiza
     contraste del texto sin importar la imagen. */
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(92deg, rgba(255,255,255,0.96) 0%, rgba(255,255,255,0.82) 38%, rgba(255,255,255,0.32) 66%, rgba(95,58,44,0.14) 100%);
  }
  @media (max-width: 760px) {
    .hero__scrim {
      background:
        linear-gradient(0deg, rgba(255,255,255,0.96) 8%, rgba(255,255,255,0.7) 42%, rgba(255,255,255,0.4) 100%);
    }
  }
  .hero__content { position: relative; z-index: 1; padding-block: clamp(3rem, 8vh, 6rem); width: 100%; }
  .hero__title { font-size: var(--fs-3xl); max-width: 16ch; }
  .hero__subtitle { font-size: var(--fs-lg); color: var(--color-text-muted); max-width: 46ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.6rem; }

  /* INTRO */
  .intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .intro__first { font-size: var(--fs-xl); color: var(--color-text); }
  @media (max-width: 800px) { .intro { grid-template-columns: 1fr; } }

  /* SERVICIOS — grid de 3 col con separadores de 1px, sin iconos de colores */
  .serv { background: var(--clay-050); }
  .serv__head { margin-bottom: clamp(1.5rem, 4vw, 3rem); }
  .serv__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }
  .serv__item {
    position: relative;
    display: flex; align-items: baseline; gap: 0.9rem;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: #fff; color: inherit; text-decoration: none;
    transition: background 0.4s var(--ease-soft);
  }
  .serv__item:hover { background: var(--clay-050); }
  .serv__n { font-family: var(--font-serif); font-style: italic; color: var(--clay-500); font-size: 1.1rem; }
  .serv__name { font-size: var(--fs-lg); }
  .serv__arrow {
    position: absolute; right: clamp(1.2rem, 2.5vw, 1.8rem); top: 50%; margin-top: -0.7em;
    color: var(--clay-700); opacity: 0; transform: translateX(-4px);
    transition: opacity 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
  }
  .serv__item:hover .serv__arrow { opacity: 1; transform: none; }
  .serv__more { margin-top: 2rem; }
  @media (max-width: 800px) { .serv__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .serv__grid { grid-template-columns: 1fr; } }

  /* CTA */
  .cta { background: var(--clay-900); color: #fff; text-align: center; }
  .cta__title { color: #fff; font-size: var(--fs-2xl); }
  .cta__actions { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
  .cta .btn--solid { background: #fff; color: var(--clay-900); border-color: #fff; }
  .cta .btn--solid:hover { background: var(--clay-050); }
  .cta .btn--ghost { color: #fff; border-color: rgba(255,255,255,0.5); }
  .cta .btn--ghost:hover { background: rgba(255,255,255,0.08); }
</style>
