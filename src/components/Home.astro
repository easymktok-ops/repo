---
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../i18n/site';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const base = `/${lang}`;

const servicios = [
  { key: 'serv.1', n: '01' },
  { key: 'serv.2', n: '02' },
  { key: 'serv.3', n: '03' },
  { key: 'serv.4', n: '04' },
  { key: 'serv.5', n: '05' },
  { key: 'serv.6', n: '06' },
  { key: 'serv.7', n: '07' },
  { key: 'serv.8', n: '08' },
] as const;
---
<!-- HERO -->
<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <img
      src="/img/optimized/full/WhatsAppImage2024-09-25at3.37.13PM.webp"
      alt=""
      fetchpriority="high"
      width="1600" height="900"
    />
    <div class="hero__scrim"></div>
  </div>
  <div class="hero__content container">
    <p class="eyebrow">{t('hero.eyebrow')}</p>
    <h1 class="hero__title">{t('hero.title')}</h1>
    <p class="hero__subtitle">{t('hero.subtitle')}</p>
    <div class="hero__actions">
      <a href={`${base}/contacto/`} class="btn btn--solid">{t('hero.cta')}</a>
      <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">{t('hero.cta2')}</a>
    </div>
  </div>
</section>

<!-- INTRO / COPY DE MARCA -->
<section class="section container intro">
  <div class="intro__lead reveal">
    <p class="eyebrow">{t('intro.eyebrow')}</p>
    <p class="intro__first display">{t('intro.p1')}</p>
  </div>
  <div class="intro__body reveal">
    <p>{t('intro.p2')}</p>
    <p>{t('intro.p3')}</p>
    <p>{t('intro.p4')}</p>
  </div>
</section>

<!-- SERVICIOS -->
<section class="section serv" id="servicios">
  <div class="container">
    <div class="serv__head reveal">
      <p class="eyebrow">{t('serv.eyebrow')}</p>
      <h2>{t('serv.title')}</h2>
    </div>
    <ul class="serv__grid reveal">
      {servicios.map((s) => (
        <li class="serv__item">
          <span class="serv__n">{s.n}</span>
          <span class="serv__name">{t(s.key)}</span>
        </li>
      ))}
    </ul>
    <a href={`${base}/servicios/`} class="btn btn--ghost serv__more">{t('nav.servicios')}</a>
  </div>
</section>

<!-- CTA CONTACTO -->
<section class="section cta">
  <div class="container cta__inner reveal">
    <h2 class="cta__title">{t('form.title')}</h2>
    <div class="cta__actions">
      <a href={`${base}/contacto/`} class="btn btn--solid">{t('nav.reservar')}</a>
      <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">{t('hero.cta2')}</a>
    </div>
  </div>
</section>

<style>
  /* HERO */
  .hero { position: relative; min-height: 84vh; display: flex; align-items: flex-end; overflow: hidden; }
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .hero__media img {
    width: 100%; height: 100%; object-fit: cover;
    animation: heroZoom 20s var(--ease-soft) infinite alternate; /* zoom lento */
  }
  .hero__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(255,255,255,0.94) 0%, rgba(255,255,255,0.72) 34%, rgba(255,255,255,0.15) 62%, rgba(95,58,44,0.12) 100%);
  }
  @keyframes heroZoom { from { transform: scale(1); } to { transform: scale(1.07); } }
  .hero__content { position: relative; z-index: 1; padding-block: clamp(3rem, 8vh, 6rem); width: 100%; }
  .hero__title { font-size: var(--fs-3xl); max-width: 16ch; }
  .hero__subtitle { font-size: var(--fs-lg); color: var(--color-text-muted); max-width: 46ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.6rem; }

  /* INTRO */
  .intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .intro__first { font-size: var(--fs-xl); color: var(--color-text); }
  @media (max-width: 800px) { .intro { grid-template-columns: 1fr; } }

  /* SERVICIOS — grid de 3 col con separadores de 1px, sin iconos de colores */
  .serv { background: var(--clay-050); }
  .serv__head { margin-bottom: clamp(1.5rem, 4vw, 3rem); }
  .serv__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }
  .serv__item {
    display: flex; align-items: baseline; gap: 0.9rem;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: #fff;
    transition: background 0.4s var(--ease-soft);
  }
  .serv__item:hover { background: var(--clay-050); }
  .serv__n { font-family: var(--font-serif); font-style: italic; color: var(--clay-500); font-size: 1.1rem; }
  .serv__name { font-size: var(--fs-lg); }
  .serv__more { margin-top: 2rem; }
  @media (max-width: 800px) { .serv__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .serv__grid { grid-template-columns: 1fr; } }

  /* CTA */
  .cta { background: var(--clay-900); color: #fff; text-align: center; }
  .cta__title { color: #fff; font-size: var(--fs-2xl); }
  .cta__actions { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
  .cta .btn--solid { background: #fff; color: var(--clay-900); border-color: #fff; }
  .cta .btn--solid:hover { background: var(--clay-050); }
  .cta .btn--ghost { color: #fff; border-color: rgba(255,255,255,0.5); }
  .cta .btn--ghost:hover { background: rgba(255,255,255,0.08); }
</style>
