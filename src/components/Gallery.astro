---
import type { Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };

// Selección curada de fotos reales de instalaciones y tratamientos.
const photos = [
  'WhatsAppImage2024-09-25at3.37.13PM', 'IMG-20211215-WA0004', 'IMG-20211216-WA0032',
  'WhatsAppImage2024-09-25at3.37.14PM', 'IMG-20211214-WA0031', 'WhatsAppImage2024-09-25at3.37.12PM',
  'IMG-20211214-WA0030', 'WhatsAppImage2024-09-25at3.37.16PM', 'WhatsAppImage2024-09-25at3.49.15PM',
  'IMG-20211214-WA0026', 'WhatsAppImage2024-09-25at9.54.20AM', 'WhatsAppImage2024-09-25at9.55.43AM',
  'WhatsAppImage2024-09-25at9.56.31AM', 'WhatsAppImage2024-09-25at3.37.15PM1', 'WhatsAppImage2024-09-25at3.37.13PM2',
  '454688961_122094352094478255_2460638138660793416_n', 'WhatsAppImage2024-10-02at11.14.49AM',
  'dg', 'fdh-min', 'fgxty-min', 'dsf-min', 'awerrt-min',
  'photo-1506126613408-eca07ce68773', 'photo-1515377905703-c4788e51af15', 'photo-1580489944761-15a19d654956',
  'photo-1610289982320-3891f7c9fd6d', 'photo-1614275703364-fd8193229051', 'photo-1639162906614-0603b0ae95fd',
  'spa-composition-with-care-items-light-wall_169016-1509', 'rt', 'wer',
];
const alt = lang === 'es' ? 'The Spa Mita en Punta de Mita' : 'The Spa Mita in Punta de Mita';
---
<section class="section container">
  <div class="gallery">
    {photos.map((name, i) => (
      <figure class="gallery__item">
        <img
          src={`/img/optimized/thumb/${name}.webp`}
          srcset={`/img/optimized/thumb/${name}.webp 640w, /img/optimized/full/${name}.webp 1600w`}
          sizes="(max-width: 700px) 100vw, 33vw"
          alt={`${alt} — ${i + 1}`}
          loading="lazy" decoding="async"
        />
      </figure>
    ))}
  </div>
</section>

<style>
  .gallery { columns: 3; column-gap: 12px; }
  .gallery__item { margin: 0 0 12px; break-inside: avoid; }
  .gallery__item img { width: 100%; display: block; }
  @media (max-width: 900px) { .gallery { columns: 2; } }
  @media (max-width: 520px) { .gallery { columns: 1; } }
</style>
