---
import type { Lang } from '../i18n/ui';
import { wb } from '../lib/paths';
const { lang } = Astro.props as { lang: Lang };

// Selección curada de 5 fotos reales (instalaciones y experiencia).
const photos = [
  'WhatsAppImage2024-09-25at3.37.14PM',   // montaje en playa (feature)
  'IMG-20211216-WA0032',                  // recepción / mural de árbol
  'IMG-20211215-WA0004',                  // sala de tratamiento
  '454688961_122094352094478255_2460638138660793416_n', // velas / masaje
  'WhatsAppImage2024-09-25at3.37.13PM2',  // camilla frente al jardín/mar
];
const alt = lang === 'es' ? 'The Spa Mita en Punta de Mita' : 'The Spa Mita in Punta de Mita';
---
<section class="section container">
  <div class="gallery">
    {photos.map((name, i) => (
      <figure class:list={['gallery__item', { 'gallery__item--feature': i === 0 }]}>
        <img
          src={wb(`/img/optimized/thumb/${name}.webp`)}
          srcset={`${wb(`/img/optimized/thumb/${name}.webp`)} 640w, ${wb(`/img/optimized/full/${name}.webp`)} 1600w`}
          sizes={i === 0 ? '(max-width: 700px) 100vw, 50vw' : '(max-width: 700px) 50vw, 25vw'}
          alt={`${alt} — ${i + 1}`}
          loading="lazy" decoding="async"
        />
      </figure>
    ))}
  </div>
</section>

<style>
  .gallery {
    display: grid; gap: 12px;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    aspect-ratio: 2 / 1;              /* 4 col x 2 filas de celdas cuadradas */
  }
  .gallery__item { margin: 0; overflow: hidden; }
  .gallery__item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s var(--ease-soft); }
  .gallery__item:hover img { transform: scale(1.04); }
  .gallery__item--feature { grid-column: span 2; grid-row: span 2; }
  @media (max-width: 700px) {
    .gallery { grid-template-columns: repeat(2, 1fr); grid-template-rows: none; aspect-ratio: auto; }
    .gallery__item { aspect-ratio: 1; }
    .gallery__item--feature { grid-column: span 2; aspect-ratio: 16 / 10; }
  }
</style>
