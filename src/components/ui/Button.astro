---
import Icon from "./Icon.astro";

/**
 * Button.astro - CTA reutilizable. Renderiza <a> si hay href, si no <button>.
 * Variantes con Shape Consistency Lock (pill) y feedback de presion (scale .97).
 * Regla de copy: verbo + objeto. Contraste AA verificado en ambas variantes.
 */
interface Props {
  href?: string;
  variant?: "primary" | "ghost" | "quiet";
  size?: "md" | "lg";
  icon?: string; // glifo Phosphor trailing opcional
  iconLeading?: string;
  type?: "button" | "submit";
  class?: string;
  dataAttrs?: Record<string, string>;
  rel?: string;
  target?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  icon,
  iconLeading,
  type = "button",
  class: className,
  rel,
  target,
} = Astro.props;

const Tag = href ? "a" : "button";
const cls = ["btn", `btn-${variant}`, `btn-${size}`, className];
---

<Tag
  class:list={cls}
  href={href}
  rel={rel}
  target={target}
  type={href ? undefined : type}
>
  {iconLeading && <Icon name={iconLeading} class="btn-ico" />}
  <span class="btn-label"><slot /></span>
  {icon && <Icon name={icon} class="btn-ico" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    transition:
      transform var(--dur-press) var(--ease-out),
      background-color var(--dur-pop) var(--ease-out),
      border-color var(--dur-pop) var(--ease-out),
      color var(--dur-pop) var(--ease-out);
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn-ico {
    font-size: 1.15em;
  }

  .btn-md {
    padding: 0.72rem 1.25rem;
    font-size: var(--step-0);
  }
  .btn-lg {
    padding: 0.95rem 1.6rem;
    font-size: var(--step-1);
  }

  /* Primary: acento solido, tinta oscura (contraste alto) */
  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .btn-primary:hover {
    background: var(--accent-strong);
  }

  /* Ghost: contorno hairline sobre oscuro */
  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Quiet: texto simple con subrayado en hover, para acciones terciarias */
  .btn-quiet {
    background: transparent;
    color: var(--muted);
    padding-inline: 0.5rem;
  }
  .btn-quiet:hover {
    color: var(--ink);
  }
</style>
