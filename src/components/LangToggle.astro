---
// Toggle de idioma ES/EN con banderas e indicador visual del idioma activo.
// Cambia de ruta (/es <-> /en) conservando la sub-ruta y guarda la preferencia.
import type { Lang } from '../i18n/ui';
import { wb } from '../lib/paths';
const { lang, path } = Astro.props as { lang: Lang; path: string };
const esHref = (wb(`/es/${path}`).replace(/\/+$/, '') || '/') + '/';
const enHref = (wb(`/en/${path}`).replace(/\/+$/, '') || '/') + '/';
---
<div class="lang-toggle" role="group" aria-label="Idioma / Language">
  <a href={esHref} class:list={['lang-toggle__opt', { 'is-active': lang === 'es' }]}
     data-set-lang="es" hreflang="es" aria-current={lang === 'es' ? 'true' : undefined}>
    <span class="lang-toggle__flag" aria-hidden="true">🇲🇽</span><span>ES</span>
  </a>
  <a href={enHref} class:list={['lang-toggle__opt', { 'is-active': lang === 'en' }]}
     data-set-lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>
    <span class="lang-toggle__flag" aria-hidden="true">🇺🇸</span><span>EN</span>
  </a>
</div>

<script>
  document.querySelectorAll('[data-set-lang]').forEach((el) => {
    el.addEventListener('click', () => {
      try { localStorage.setItem('spamita_lang', el.getAttribute('data-set-lang') || 'es'); } catch (e) {}
    });
  });
</script>

<style>
  .lang-toggle {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.2rem; border: 1px solid var(--color-line); border-radius: 999px;
    background: var(--color-bg);
  }
  .lang-toggle__opt {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: var(--fs-xs); font-weight: var(--fw-medium); letter-spacing: 0.06em;
    color: var(--color-text-muted); padding: 0.35rem 0.7rem; border-radius: 999px;
    transition: color 0.3s var(--ease-soft), background 0.3s var(--ease-soft);
  }
  .lang-toggle__opt:hover { color: var(--clay-700); }
  .lang-toggle__opt.is-active { background: var(--clay-900); color: #fff; }
  .lang-toggle__flag { font-size: 0.95rem; line-height: 1; }
</style>
