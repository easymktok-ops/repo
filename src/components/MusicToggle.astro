---
// Toggle de música de fondo (chill), apagado por defecto.
// Los navegadores bloquean el autoplay con sonido, así que suena solo tras un
// clic del usuario; la preferencia se recuerda en localStorage.
// El botón se oculta automáticamente si no hay archivo de audio disponible.
import { wb } from '../lib/paths';
---
<button class="music" data-music aria-label="Música de fondo" aria-pressed="false">
  <span class="music__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M9 17.5a2.5 2.5 0 1 1-2.5-2.5c.4 0 .8.1 1.1.2V6.3l8-1.6v8.3a2.5 2.5 0 1 1-2.5-2.5c.4 0 .8.1 1.1.2V6.5L9 7.6v9.9z"/></svg>
  </span>
  <span class="music__wave" aria-hidden="true"><i></i><i></i><i></i></span>
</button>

<audio data-music-audio loop preload="none" src={wb('/audio/ambient.mp3')}></audio>

<script>
  const btn = document.querySelector('[data-music]');
  const audio = document.querySelector('[data-music-audio]');
  if (btn && audio) {
    audio.volume = 0.35;

    // El botón se muestra por defecto; se oculta sólo si el audio falla
    // (por ejemplo, si el archivo no existe).
    audio.addEventListener('error', () => { btn.hidden = true; });

    const setState = (on) => {
      btn.classList.toggle('is-playing', on);
      btn.setAttribute('aria-pressed', String(on));
    };

    btn.addEventListener('click', async () => {
      if (audio.paused) {
        try { await audio.play(); setState(true); localStorage.setItem('spamita_music', 'on'); } catch (e) {}
      } else {
        audio.pause(); setState(false); localStorage.setItem('spamita_music', 'off');
      }
    });

    // Si el usuario ya la tenía activada, intentar reanudar al primer gesto
    if (localStorage.getItem('spamita_music') === 'on') {
      const resume = () => {
        audio.play().then(() => setState(true)).catch(() => {});
        window.removeEventListener('pointerdown', resume);
      };
      window.addEventListener('pointerdown', resume, { once: true });
    }
  }
</script>

<style>
  .music {
    position: fixed; right: clamp(1rem, 3vw, 1.75rem);
    bottom: calc(clamp(1rem, 3vw, 1.75rem) + 68px);
    z-index: 55; height: 44px; padding: 0 0.7rem;
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--color-bg); color: var(--clay-900);
    border: 1px solid var(--color-line); border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.08); cursor: pointer;
    transition: color .3s var(--ease-soft), border-color .3s var(--ease-soft);
  }
  .music[hidden] { display: none !important; }
  .music:hover { color: var(--clay-700); border-color: var(--clay-500); }
  .music__wave { display: inline-flex; align-items: flex-end; gap: 2px; height: 14px; }
  .music__wave i { width: 2px; height: 4px; background: var(--clay-500); border-radius: 1px; }
  .music.is-playing .music__wave i { animation: eq 0.9s var(--ease-soft) infinite; }
  .music.is-playing .music__wave i:nth-child(2) { animation-delay: 0.15s; }
  .music.is-playing .music__wave i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes eq { 0%,100% { height: 4px; } 50% { height: 14px; } }
  @media (prefers-reduced-motion: reduce) { .music.is-playing .music__wave i { animation: none; } }
</style>
