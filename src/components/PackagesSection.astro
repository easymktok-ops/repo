---
import { packages } from '../data/site.js';
import PackageCard from './PackageCard.jsx';
const BASE = import.meta.env.BASE_URL;
const gSmile = `${BASE}assets/globos/globo-smile.png`.replace(/\/{2,}/g, '/');
const gStar = `${BASE}assets/globos/globo-star.png`.replace(/\/{2,}/g, '/');
---

<section id="paquetes" class="relative bg-cream py-20 sm:py-28">
  <!-- deco blobs -->
  <div class="pointer-events-none absolute -left-16 top-24 h-40 w-40 rounded-full bg-mint/25 blur-2xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute right-0 top-1/2 h-52 w-52 rounded-full bg-sky/20 blur-3xl" aria-hidden="true"></div>

  <!-- Globos REALES recortados con parallax (grandes, hacia el centro) -->
  <div class="parallax-layer" aria-hidden="true">
    <img src={gSmile} class="parallax-balloon" data-speed="0.13" style="left:1%;top:-1%;width:470px;opacity:.95;transform:rotate(-6deg)" alt="" />
    <img src={gStar} class="parallax-balloon" data-speed="0.22" style="right:0%;top:7%;width:410px;opacity:.92;transform:rotate(5deg)" alt="" />
    <img src={gStar} class="parallax-balloon" data-speed="0.10" style="left:2%;bottom:2%;width:360px;opacity:.9;transform:rotate(4deg)" alt="" />
    <img src={gSmile} class="parallax-balloon" data-speed="0.18" style="right:0%;bottom:-1%;width:440px;opacity:.92;transform:rotate(-5deg)" alt="" />
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <header class="mx-auto mb-12 max-w-2xl text-center reveal">
      <span class="sticker mb-3 inline-block rounded-full bg-yellow-lt px-4 py-1.5 font-sub text-sm font-semibold text-ink">
        Paquetes
      </span>
      <h2 class="font-display text-[clamp(2.4rem,6vw,4.5rem)] leading-[0.95] text-ink">
        Elige tu vuelo <span class="text-yellow-dk">feliz</span>
      </h2>
      <p class="mt-4 font-body text-lg text-ink/70">
        Arma tu experiencia, elige personas y fecha, y cierra por WhatsApp en un mensaje.
        Sin pagos en línea: te atendemos personalmente.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-12 lg:gap-6">
      {packages.map((pkg, i) => (
        <div
          class:list={[
            'reveal h-full',
            pkg.span,
            pkg.variant === 'love' && 'md:col-span-2',
          ]}
          style={`transition-delay:${(i % 3) * 80}ms`}
        >
          <PackageCard client:visible {...pkg} />
        </div>
      ))}
    </div>

    <p class="mt-10 text-center font-sub text-ink/60">
      ¿Dudas para elegir? <a href="#contacto" class="font-semibold text-ink underline decoration-yellow decoration-2 underline-offset-4">Escríbenos</a> y te ayudamos.
    </p>
  </div>
</section>

<script>
  // Parallax sutil de los globitos detrás de las tarjetas.
  // Se mueven a distintas velocidades según data-speed cuando la sección
  // cruza el viewport. Respeta prefers-reduced-motion y solo corre si hay globos.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.getElementById('paquetes');
  const balloons = section
    ? Array.from(section.querySelectorAll('.parallax-balloon'))
    : [];

  if (!reduce && section && balloons.length) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      // 0 cuando el centro de la sección está en el centro del viewport;
      // negativo al subir, positivo al bajar.
      const center = rect.top + rect.height / 2 - vh / 2;
      // Solo animamos si la sección está (casi) en pantalla.
      if (rect.bottom < -200 || rect.top > vh + 200) return;
      balloons.forEach((el) => {
        const speed = parseFloat(el.getAttribute('data-speed')) || 0;
        const base = el.getAttribute('data-rot') || '';
        el.style.transform = `translate3d(0, ${(-center * speed).toFixed(1)}px, 0) ${base}`;
      });
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    // Guardamos la rotación base de cada globo para no perderla al animar.
    balloons.forEach((el) => {
      const m = /rotate\([^)]+\)/.exec(el.getAttribute('style') || '');
      if (m) el.setAttribute('data-rot', m[0]);
    });

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
