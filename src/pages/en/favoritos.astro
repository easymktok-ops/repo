---
import PageShell from "@layouts/PageShell.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import FlightCatalog from "@components/sections/FlightCatalog.astro";
import Button from "@components/ui/Button.astro";
import Icon from "@components/ui/Icon.astro";
import { localizedPath } from "@config/site";

const locale = "en" as const;
---

<PageShell
  title="Favorites"
  description="The balloon flights you saved as favorites, kept on this device."
  logicalPath="/favoritos"
  activeId="favorites"
  noindex
>
  <PageHeader
    title="Your favorites"
    lead="The flights you marked with the heart show up here. They're kept on this device, with no account or sign-up."
  />

  <div id="favCatalog">
    <FlightCatalog locale={locale} page />
  </div>

  <section id="favEmpty" class="fav-empty container" hidden>
    <div class="fav-empty-card">
      <span class="fav-empty-ico"><Icon name="heart" /></span>
      <h2>No favorites yet</h2>
      <p class="measure">
        Browse the flights and tap the heart on the ones you like most. They're saved
        on this device so you can come back to them.
      </p>
      <Button href={localizedPath("/vuelos", locale)} icon="arrow-up-right">Explore flights</Button>
    </div>
  </section>
</PageShell>

<script>
  const KEY = "aero:favs";
  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(KEY) || "[]");
    } catch {
      return [];
    }
  };
  function refresh() {
    const favs = read();
    let shown = 0;
    document.querySelectorAll<HTMLElement>("#favCatalog .card").forEach((c) => {
      const on = favs.includes(c.dataset.slug || "");
      c.style.display = on ? "" : "none";
      if (on) shown++;
    });
    const empty = document.getElementById("favEmpty");
    const cat = document.getElementById("favCatalog");
    if (empty) empty.hidden = shown > 0;
    if (cat) cat.hidden = shown === 0;
  }
  document.addEventListener("favs:changed", refresh);
  refresh();
</script>

<style>
  .fav-empty {
    padding-block: var(--space-xl) var(--space-3xl);
  }
  .fav-empty-card {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-sm);
    max-width: 560px;
    margin-inline: auto;
    padding: var(--space-2xl) var(--space-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .fav-empty-ico {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-pill);
    background: var(--accent-wash);
    color: var(--accent);
    font-size: 1.8rem;
    margin-bottom: var(--space-2xs);
  }
  .fav-empty-card h2 {
    font-size: var(--step-2);
  }
  .fav-empty-card p {
    color: var(--muted);
  }
</style>
