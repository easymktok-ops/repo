---
import PageShell from "@layouts/PageShell.astro";
import Hero from "@components/sections/Hero.astro";
import BoardingPassBar from "@components/sections/BoardingPassBar.astro";
import { site } from "@config/site";

/**
 * Home (en). Mirror of the es home. More sections land through Phase 2.
 */
const locale = "en" as const;
---

<PageShell
  title={site.name}
  description={site.brand.tagline.en}
  logicalPath="/"
  activeId="home"
>
  <Hero locale={locale} />
  <BoardingPassBar locale={locale} />
</PageShell>
