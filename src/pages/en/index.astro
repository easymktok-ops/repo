---
import PageShell from "@layouts/PageShell.astro";
import Hero from "@components/sections/Hero.astro";
import BoardingPassBar from "@components/sections/BoardingPassBar.astro";
import FlightCatalog from "@components/sections/FlightCatalog.astro";
import Ocasiones from "@components/sections/Ocasiones.astro";
import DoubleExposure from "@components/sections/DoubleExposure.astro";
import Gallery from "@components/sections/Gallery.astro";
import Testimonials from "@components/sections/Testimonials.astro";
import Faq from "@components/sections/Faq.astro";
import { site } from "@config/site";

const locale = "en" as const;
---

<PageShell
  title={site.name}
  description={site.brand.tagline.en}
  logicalPath="/"
  activeId="home"
>
  <Hero locale={locale} />
  <BoardingPassBar locale={locale} reviewCount={site.brand.reviews.count} />
  <FlightCatalog locale={locale} />
  <Ocasiones locale={locale} />
  <DoubleExposure locale={locale} />
  <Gallery locale={locale} />
  <Testimonials locale={locale} />
  <Faq locale={locale} />
</PageShell>
