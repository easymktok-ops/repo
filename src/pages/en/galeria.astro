---
import PageShell from "@layouts/PageShell.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import Gallery from "@components/sections/Gallery.astro";

const locale = "en" as const;
---

<PageShell
  title="Gallery"
  description="Real photos of Aerodiverti balloon flights over the Teotihuacán valley."
  logicalPath="/galeria"
  activeId="gallery"
>
  <PageHeader
    title="Gallery"
    lead="Sunrises, pyramids and the valley seen from the air. Real photos from our flights."
  />
  <Gallery locale={locale} page />
</PageShell>
