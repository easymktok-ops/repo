---
import PageShell from "@layouts/PageShell.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import { site, whatsappUrl } from "@config/site";

const locale = "en" as const;
const c = site.brand;
const wa = whatsappUrl();
---

<PageShell
  title="Privacy notice"
  description="What data Aerodiverti collects, how it is used, who it is shared with, and how to exercise your rights."
  logicalPath="/aviso-de-privacidad"
  activeId=""
>
  <PageHeader
    title="Privacy notice"
    lead="We ask for your name, phone and email so we can confirm your flight and reach you if the weather forces a change. We do not sell your data."
  />

  <article class="legal container-narrow">
    <p class="legal-updated">Last updated: July 22, 2026</p>

    <p class="legal-lead">
      Your card is processed by Stripe and PayPal: we never see it or store it.
    </p>

    <h2>Who handles your data</h2>
    <p>
      {site.name}, a hot-air balloon flight operator departing from the Aerodiverti launch site
      in {c.address.area}, is responsible for processing the personal data you provide on this
      site.
    </p>

    <h2>What we collect</h2>
    <ul>
      <li><strong>For the booking:</strong> full name, phone and email.</li>
      <li>
        <strong>About the flight:</strong> chosen date, number of passengers, add-ons booked
        and, if applicable, the occasion you are celebrating.
      </li>
      <li>
        <strong>About the payment:</strong> only the transaction identifier and the amount. Your
        card details go straight to the payment gateway and never pass through our servers.
      </li>
      <li>
        <strong>About site usage:</strong> anonymous browsing data (pages viewed, device type)
        to understand what works and what does not.
      </li>
    </ul>

    <h2>How we use it</h2>
    <ul>
      <li>To confirm your booking and send you your boarding pass.</li>
      <li>
        To reach you if the weather forces us to reschedule or cancel the flight: the captain
        makes that call the morning of the flight, so we need a phone that answers.
      </li>
      <li>To keep the passenger records required by aviation operations.</li>
      <li>To handle questions, changes and invoicing.</li>
    </ul>
    <p>
      We will only send you promotions if you expressly opt in, and you can unsubscribe at any
      time.
    </p>

    <h2>Who we share it with</h2>
    <p>Only with whoever is needed for you to fly and for the payment to work:</p>
    <ul>
      <li>Stripe and PayPal, to process the payment.</li>
      <li>The hosting provider where the site and the booking database live.</li>
      <li>The email service we use to send your confirmation.</li>
      <li>The aviation authority, when required for the safety of the operation.</li>
    </ul>
    <p>We do not sell, rent or transfer your data to third parties for commercial purposes.</p>

    <h2>How long we keep it</h2>
    <p>
      We keep your booking data for as long as it is needed for the operation and to meet tax and
      safety obligations. After that it is deleted or anonymized.
    </p>

    <h2>Your rights (ARCO)</h2>
    <p>
      You can request Access to your data, its Rectification if it is wrong, its Cancellation when
      it is no longer needed, or Object to a specific use. You can also withdraw your consent.
      Write to <a href={`mailto:${c.email}`}>{c.email}</a> or message us on
      <a href={wa} target="_blank" rel="noopener">WhatsApp</a>, telling us what you want to do and
      for which booking. We respond within 20 business days at most.
    </p>
    <p>
      If you believe your data protection rights were violated, you can turn to Mexico's INAI
      (<a href="https://home.inai.org.mx/" target="_blank" rel="noopener">inai.org.mx</a>).
    </p>

    <h2>Cookies</h2>
    <p>
      We use browser storage to remember a half-finished booking (if you reload, you do not lose
      what you had) and measurement tools to see where in the process people drop off. These
      tools only run if you accept them in the cookie banner. You can clear them from your browser
      settings; if you do, you will have to fill out the form again.
    </p>

    <h2>Changes to this notice</h2>
    <p>If anything relevant changes, it is posted here with the update date at the top.</p>

    <p class="legal-contact">
      Questions about this document? Message us on
      <a href={wa} target="_blank" rel="noopener">WhatsApp</a> or at
      <a href={`mailto:${c.email}`}>{c.email}</a>.
    </p>
  </article>
</PageShell>

<style>
  .legal {
    padding-block: var(--space-md) var(--space-3xl);
  }
  .legal-updated {
    color: var(--faint);
    font-size: var(--step--1);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    margin-bottom: var(--space-lg);
  }
  .legal-lead {
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.55;
    margin-bottom: var(--space-xl);
  }
  .legal h2 {
    font-size: var(--step-2);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-2xs);
  }
  .legal p,
  .legal li {
    color: var(--muted);
    font-size: var(--step-0);
    line-height: 1.65;
  }
  .legal ul {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.45rem;
    margin-top: var(--space-2xs);
  }
  .legal ul + p {
    margin-top: var(--space-sm);
  }
  .legal a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal strong {
    color: var(--ink-soft);
  }
  .legal-contact {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--line-faint);
    color: var(--ink-soft);
  }
</style>
