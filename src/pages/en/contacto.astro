---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import Hours from '../../components/Hours.astro';
import { site } from '../../i18n/site';
import { useTranslations } from '../../i18n/ui';
const t = useTranslations('en');
---
<BaseLayout lang="en" title={t('seo.contacto.title')} description={t('seo.contacto.desc')} path="contacto">
  <PageHero eyebrow={t('form.eyebrow')} title={t('form.title')} lead={t('form.intro')} />
  <section class="section container contact-grid">
    <ContactForm lang="en" />
    <aside class="contact-aside">
      <p class="eyebrow">The Spa Mita</p>
      <p>{site.address.locality}, {site.address.region}, Mexico</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p><a href={site.whatsapp} target="_blank" rel="noopener noreferrer">{t('hero.cta2')} · {site.phoneDisplay}</a></p>
      <p class="contact-aside__hlabel">{t('side.horario.label')}</p>
      <Hours lang="en" />
    </aside>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact-aside p { color: var(--color-text-muted); margin: 0 0 0.7rem; }
  .contact-aside a:hover { color: var(--clay-700); }
  @media (max-width: 800px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
