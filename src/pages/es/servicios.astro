---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceList from '../../components/ServiceList.astro';
import { useTranslations } from '../../i18n/ui';
const t = useTranslations('es');
---
<BaseLayout lang="es" title={t('seo.servicios.title')} description={t('seo.servicios.desc')} path="servicios">
  <PageHero
    eyebrow={t('serv.eyebrow')}
    title={t('serv.page.title')}
    lead={t('serv.page.lead')}
    image="/img/optimized/full/454688961_122094352094478255_2460638138660793416_n.webp"
  />
  <section class="section"><ServiceList lang="es" /></section>
</BaseLayout>
