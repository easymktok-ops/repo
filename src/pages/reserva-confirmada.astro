---
import PageShell from "@layouts/PageShell.astro";
import Icon from "@components/ui/Icon.astro";
import { Image } from "astro:assets";
import wordmark from "@/assets/brand/aerodiverti-wordmark-dark.png";
import { whatsappUrl, site } from "@config/site";

const locale = "es" as const;
const wa = whatsappUrl("Hola, acabo de reservar mi vuelo. Quiero confirmar los detalles.");
---

<PageShell
  title="Reserva confirmada"
  description="Gracias por reservar tu vuelo en globo con Aerodiverti."
  logicalPath="/reserva-confirmada"
  activeId=""
  noindex
>
  <section class="confirm container-narrow">
    <Image src={wordmark} alt={site.name} class="confirm-brand" loading="eager" />
    <span class="confirm-badge"><Icon name="check-circle" /></span>
    <h1 class="confirm-title">Tu reserva está confirmada</h1>
    <p class="confirm-ref" data-ref>
      Recibimos tu pago. En breve te llega el correo de confirmación.
    </p>
    <p class="confirm-lead">
      Te contactaremos para afinar la fecha exacta y el punto de encuentro en el
      globopuerto. Si pagaste un anticipo, el saldo se liquida en sitio el día
      del vuelo. Revisa tu correo (y la carpeta de spam por si acaso).
    </p>
    <div class="confirm-actions">
      <a class="confirm-btn confirm-primary" href={wa}>
        <Icon name="whatsapp-logo" /> Escribir por WhatsApp
      </a>
      <a class="confirm-btn confirm-ghost" href="/">Volver al inicio</a>
    </div>
  </section>
</PageShell>

<script is:inline>
  (function () {
    var p = new URLSearchParams(location.search);
    var ref = p.get("ref");
    var amt = parseFloat(p.get("amt") || "0");
    var cur = (p.get("cur") || "MXN").toUpperCase();
    if (ref) {
      var el = document.querySelector("[data-ref]");
      if (el) {
        el.textContent = "Tu número de reserva es " + ref + ". En breve te llega el correo de confirmación.";
      }
    }
    // Conversion: purchase (dedupe por transaction_id). Solo si hay consentimiento
    // (dataLayer existe cuando el usuario acepto cookies).
    try {
      if (ref && window.dataLayer) {
        window.dataLayer.push({
          event: "purchase",
          ecommerce: {
            transaction_id: ref,
            currency: cur,
            value: isNaN(amt) ? undefined : amt,
          },
        });
      }
      if (ref && typeof window.fbq === "function") {
        window.fbq("track", "Purchase", { value: isNaN(amt) ? undefined : amt, currency: cur });
      }
    } catch (e) {}
  })();
</script>

<style>
  .confirm {
    padding-block: var(--space-2xl) var(--space-3xl);
    text-align: center;
    max-width: 640px;
  }
  .confirm-brand {
    display: block;
    height: 1.9rem;
    width: auto;
    max-width: 70%;
    margin: 0 auto var(--space-lg);
  }
  .confirm-badge {
    display: inline-grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-pill);
    background: var(--accent-wash);
    color: var(--accent);
    font-size: 2.4rem;
    margin-bottom: var(--space-md);
  }
  .confirm-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-sm);
  }
  .confirm-ref {
    color: var(--ink-soft);
    font-size: var(--step-1);
    margin: 0 0 var(--space-sm);
  }
  .confirm-lead {
    color: var(--muted);
    line-height: var(--leading-body);
    margin: 0 auto var(--space-lg);
    max-width: 52ch;
  }
  .confirm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }
  .confirm-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--radius-pill);
    padding: 0.8rem 1.5rem;
    font-weight: 600;
    border: 1px solid transparent;
    transition:
      background-color var(--dur-pop) var(--ease-out),
      border-color var(--dur-pop) var(--ease-out),
      color var(--dur-pop) var(--ease-out);
  }
  .confirm-primary {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .confirm-primary:hover {
    background: var(--accent-strong);
  }
  .confirm-ghost {
    color: var(--muted);
    border-color: var(--line-strong);
  }
  .confirm-ghost:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
</style>
