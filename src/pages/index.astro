---
import PageShell from "@layouts/PageShell.astro";
import Hero from "@components/sections/Hero.astro";
import BoardingPassBar from "@components/sections/BoardingPassBar.astro";
import Ocasiones from "@components/sections/Ocasiones.astro";
import DoubleExposure from "@components/sections/DoubleExposure.astro";
import Gallery from "@components/sections/Gallery.astro";
import { site } from "@config/site";

/**
 * Home (es). Ritmo de secciones: video a sangre completa -> barra de confianza
 * -> ocasiones -> doble exposicion -> galeria. Faltan catalogo, testimonios y
 * FAQ (siguiente pasada).
 */
const locale = "es" as const;
---

<PageShell
  title={site.name}
  description={site.brand.tagline.es}
  logicalPath="/"
  activeId="home"
>
  <Hero locale={locale} />
  <BoardingPassBar locale={locale} />
  <Ocasiones locale={locale} />
  <DoubleExposure locale={locale} />
  <Gallery locale={locale} />
</PageShell>
