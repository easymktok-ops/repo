---
import PageShell from "@layouts/PageShell.astro";
import Hero from "@components/sections/Hero.astro";
import BoardingPassBar from "@components/sections/BoardingPassBar.astro";
import { site } from "@config/site";

/**
 * Home (es). Fase 2 en curso: hero + barra de confianza listos. Debajo entran
 * catálogo de vuelos, ocasiones, doble exposición, testimonios y FAQ.
 */
const locale = "es" as const;
---

<PageShell
  title={site.name}
  description={site.brand.tagline.es}
  logicalPath="/"
  activeId="home"
>
  <Hero locale={locale} />
  <BoardingPassBar locale={locale} />
</PageShell>
