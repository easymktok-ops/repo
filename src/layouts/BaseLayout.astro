---
import '../styles/tokens.css';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../i18n/site';
import { wb, BASE } from '../lib/paths';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string;      // sub-ruta sin prefijo de idioma ('' para home)
  ogImage?: string;
}
const { lang, title, description, path = '', ogImage = '/img/optimized/full/WhatsAppImage2024-09-25at3.37.13PM.webp' } = Astro.props;
const ogImageUrl = new URL(wb(ogImage), Astro.site).href;

const canonical = new URL(wb(`/${lang}/${path}`).replace(/\/+$/, '/'), Astro.site).href;
const esUrl = new URL(wb(`/es/${path}`).replace(/\/+$/, '/'), Astro.site).href;
const enUrl = new URL(wb(`/en/${path}`).replace(/\/+$/, '/'), Astro.site).href;

// schema.org — DaySpa (subtipo de HealthAndBeautyBusiness/LocalBusiness)
const schema = {
  '@context': 'https://schema.org',
  '@type': 'DaySpa',
  name: site.name,
  description,
  image: ogImageUrl,
  telephone: site.phoneDisplay,
  email: site.email,
  url: canonical,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  sameAs: [site.instagram, site.facebook, site.tripadvisor],
  hasMap: site.mapLink,
  areaServed: [
    'Punta de Mita', 'Bahía de Banderas', 'Sayulita', 'Nuevo Vallarta',
    'Nayarit', 'Puerto Vallarta',
  ],
  openingHours: 'Mo-Su 09:00-20:00',
  makesOffer: [
    'Masajes', 'Faciales', 'Exfoliación corporal', 'Tratamientos corporales',
    'Depilación', 'Manicure y pedicure',
  ].map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s } })),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={wb('/favicon.png')} />

    <!-- hreflang ES/EN -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fuentes (font-display: swap via Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=DM+Serif+Display:ital@1&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Marca que hay JS (habilita animaciones sin ocultar contenido sin JS) -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Redirige a idioma guardado si el usuario abre la raíz de otro idioma -->
    <script define:vars={{ base: BASE }}>
      (function () {
        try {
          var saved = localStorage.getItem('spamita_lang');
          var cur = document.documentElement.lang;
          var head = new RegExp('^' + base + '/(es|en)(/|$)');
          if (saved && saved !== cur && head.test(location.pathname)) {
            location.pathname = location.pathname.replace(new RegExp('^' + base + '/(es|en)'), base + '/' + saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Sidebar lang={lang} path={path} />
    <main class="app-main" id="contenido">
      <slot />
      <Footer lang={lang} />
    </main>
    <WhatsAppFloat />

    <button class="to-top" data-to-top aria-label="Volver arriba" title="Volver arriba">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>

    <script>
      // Parallax sutil en imágenes de hero (respeta reduced-motion)
      const px = Array.from(document.querySelectorAll('[data-parallax]'));
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (px.length && !reduce) {
        let ticking = false;
        const apply = () => {
          const vh = window.innerHeight;
          px.forEach((el) => {
            const parent = el.parentElement;
            const r = parent.getBoundingClientRect();
            if (r.bottom < 0 || r.top > vh) return; // fuera de vista
            const progress = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
            const maxShift = parent.offsetHeight * 0.06;
            const y = Math.max(-maxShift, Math.min(maxShift, -progress * maxShift));
            el.style.transform = `translate3d(0, ${y.toFixed(1)}px, 0) scale(1.03)`;
          });
          ticking = false;
        };
        window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(apply); ticking = true; } }, { passive: true });
        window.addEventListener('resize', apply, { passive: true });
        apply();
      }

      // Back to top
      const toTop = document.querySelector('[data-to-top]');
      if (toTop) {
        const onScroll = () => toTop.classList.toggle('is-visible', window.scrollY > 600);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }));
      }
    </script>

    <script>
      // Fade-in al entrar en viewport (motion sutil, sin rebotes)
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Marca el link activo en el menú
      const here = location.pathname.replace(/\/+$/, '/');
      document.querySelectorAll('.sidebar__link').forEach((a) => {
        const href = a.getAttribute('href')?.replace(/\/+$/, '/');
        if (href === here) a.setAttribute('aria-current', 'page');
      });
    </script>

    <style is:global>
      .app-main { margin-inline-start: var(--sidebar-w); min-height: 100vh; }
      body.no-scroll { overflow: hidden; }
      @media (max-width: 900px) {
        .app-main { margin-inline-start: 0; padding-top: 4rem; }
      }

      /* Back to top — sutil, esquina inferior izquierda (no choca con WhatsApp) */
      .to-top {
        position: fixed; left: clamp(1rem, 3vw, 1.75rem); bottom: clamp(1rem, 3vw, 1.75rem);
        z-index: 55; width: 44px; height: 44px; display: grid; place-items: center;
        background: var(--color-bg); color: var(--clay-900);
        border: 1px solid var(--color-line); border-radius: 999px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08); cursor: pointer;
        opacity: 0; visibility: hidden; transform: translateY(8px);
        transition: opacity .35s var(--ease-soft), transform .35s var(--ease-soft), visibility .35s;
      }
      .to-top.is-visible { opacity: 1; visibility: visible; transform: none; }
      .to-top:hover { color: var(--clay-700); border-color: var(--clay-500); }
      @media (min-width: 901px) {
        /* En desktop lo dejamos junto al borde del contenido */
        .to-top { left: calc(var(--sidebar-w) + 1.25rem); }
      }
    </style>
  </body>
</html>
