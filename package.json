{
  "name": "aerodiverti-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de reservas y experiencia de marca para Aerodiverti (vuelos en globo sobre Teotihuacan). Astro islands + React + Motion.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "cms:proxy": "decap-server",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,css,md,mdx}\" \"*.{ts,mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,css,md,mdx}\""
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.2.1",
    "@phosphor-icons/react": "^2.1.7",
    "astro": "^5.6.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource-variable/geist": "^5.1.0",
    "@fontsource-variable/geist-mono": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "decap-server": "^3.1.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
