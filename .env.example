# =============================================================================
# Aerodiverti - variables de entorno (EJEMPLO)
# -----------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` al repo.
# REGLA DE ORO: el dominio final NO se hardcodea en ningun lado del codigo.
# Cambiar de staging a produccion = editar PUBLIC_SITE_URL aqui (o en el panel
# de Hostinger), sin tocar codigo.
# =============================================================================

# --- Dominio y marca -------------------------------------------------------
# URL base absoluta del entorno actual, SIN barra final. En staging apunta al
# subdominio de trabajo de Hostinger; en produccion, al dominio confirmado.
PUBLIC_SITE_URL="https://staging.tu-subdominio-de-trabajo.hostingersite.com"
PUBLIC_SITE_NAME="Aerodiverti"
PUBLIC_DEFAULT_LOCALE="es"
PUBLIC_WHATSAPP_DISPLAY_NUMBER="+52 55 0000 0000"   # placeholder, confirmar con el negocio

# --- Analitica (IDs publicos; se cargan solo tras aceptar cookies) ---------
# Si se dejan vacios, el codigo cae a los IDs del negocio en src/config/site.ts.
PUBLIC_GA_ID="G-P4S5W2B2Y8"
PUBLIC_GOOGLE_ADS_ID="AW-18320918955"
PUBLIC_META_PIXEL_ID="1085215598312916"
PUBLIC_PLAUSIBLE_DOMAIN=""

# --- Pagos: Stripe ---------------------------------------------------------
# Publishable key: se expone al cliente (empieza con pk_). Secret key: SOLO
# servidor (empieza con sk_), jamas en codigo de cliente.
PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Notificaciones transaccionales (proveedor por definir en Fase 3) ------
# La capa de notificaciones ya tiene interfaz de adapter + outbox con
# reintentos y logging de fallos. Con provider="log" todo se registra en
# consola/archivo sin enviar nada (util en dev y para no repetir el bug de
# "sin correo enviado" del sitio de referencia: siempre queda traza).
NOTIFICATIONS_EMAIL_PROVIDER="log"          # log | resend | sendgrid
NOTIFICATIONS_EMAIL_API_KEY=""
NOTIFICATIONS_EMAIL_FROM="reservas@ejemplo.mx"
NOTIFICATIONS_WHATSAPP_PROVIDER="log"       # log | meta_cloud | twilio
NOTIFICATIONS_WHATSAPP_TOKEN=""
NOTIFICATIONS_WHATSAPP_PHONE_ID=""
NOTIFICATIONS_ADMIN_EMAIL="admin@ejemplo.mx"
NOTIFICATIONS_ADMIN_WHATSAPP="+52 55 0000 0000"

# --- CMS (Decap) -----------------------------------------------------------
# Para el backend GitHub de Decap en produccion. En local se usa el proxy
# `npm run cms:proxy` (local_backend) y estos no son necesarios.
PUBLIC_CMS_REPO="easymktok-ops/repo"
PUBLIC_CMS_BRANCH="claude/aerodiverti-platform-xajbkz"
