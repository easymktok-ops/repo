# Happy Puerto — variables de entorno (build domain-agnostic)
# Copia este archivo a ".env" y ajusta según el dominio de despliegue.

# URL canónica absoluta del sitio (opcional; usada para <link canonical> y OG).
# Ej: https://happypuerto.com  o  https://suempresa.com
SITE_URL=

# Subpath de despliegue. Deja "/" si el sitio vive en la raíz del dominio.
# Ej para subcarpeta: /happypuerto
BASE_PATH=/
